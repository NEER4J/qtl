# Supabase — from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service-role key: SERVER-ONLY. Never expose to the browser.
# Used by scripts/migrate (Excel → Postgres) and any admin server actions
# (e.g. inviting users) that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase project ref (the subdomain before .supabase.co) — used by
# `supabase gen types typescript --project-id $NEXT_PUBLIC_SUPABASE_PROJECT_ID`
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-project-ref

# Direct Postgres connection string for the migrate script. Needed because
# scripts/migrate uses transactions (supabase-js does not expose BEGIN/COMMIT).
# Local:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Remote: from Supabase project settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
